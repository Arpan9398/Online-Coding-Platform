# Copy this file to .env and edit. Every value has a development default.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/coding_platform
JWT_SECRET=change-this-to-a-long-random-string-of-32-or-more-characters
JWT_EXPIRES=12h

# Admin account created on first start (change the password!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Code judge
JUDGE_CONCURRENCY=2
# PYTHON_CMD=python3        # set to "python" or "py" if python3 is not on your PATH

# Origin allowed to call the API from a browser (React dev server)
CORS_ORIGIN=http://localhost:5173
